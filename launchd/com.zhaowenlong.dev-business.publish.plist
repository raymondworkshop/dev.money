<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zhaowenlong.dev-business.publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/zhaowenlong/workspace/dev.business/scripts/publish.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/zhaowenlong/workspace/dev.business</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LLM_PROVIDER</key>
    <string>local-gateway</string>
    <key>LLM_MODEL</key>
    <string>gemma4</string>
    <key>LLM_FALLBACK_MODELS</key>
    <string>mlx</string>
    <key>LLM_FALLBACK_ENABLED</key>
    <string>1</string>
    <key>DEPLOY</key>
    <string>1</string>
  </dict>

  <!-- Mon 00:00 and Wed 00:00 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>0</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>0</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/zhaowenlong/workspace/dev.business/logs/launchd-publish.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zhaowenlong/workspace/dev.business/logs/launchd-publish.err.log</string>
</dict>
</plist>
