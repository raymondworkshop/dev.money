# LLM backend: mlx (default) | gemini | openai
LLM_PROVIDER=mlx

# MLX (local OpenAI-compatible server on Apple Silicon)
LLM_URL=http://127.0.0.1:8080/v1/chat/completions
LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=4096
# LLM_JSON_RETRY_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=360
# LLM_WAIT_SECONDS=180

# Gemini (cloud) — set LLM_PROVIDER=gemini; falls back to mlx on failure
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# LLM_FALLBACK_PROVIDERS=mlx
# LLM_FALLBACK_ENABLED=1

# OpenAI (cloud) — set LLM_PROVIDER=openai and uncomment:
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Cloudflare Pages deploy (Wrangler reads token from env or ~/.wrangler/)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# PAGES_PROJECT=news-wiki
