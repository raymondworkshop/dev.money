# LLM backend: mlx | gemini | openai
LLM_PROVIDER=mlx

# MLX (local mlx_lm.server on Apple Silicon)
LLM_URL=http://127.0.0.1:8080/v1/chat/completions
LLM_MODEL=mlx-community/gemma-4-e4b-it-4bit

# Gemini (cloud) — set LLM_PROVIDER=gemini and uncomment:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI (cloud) — set LLM_PROVIDER=openai and uncomment:
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
